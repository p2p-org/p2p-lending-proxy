pragma solidity 0.8.27;

import "forge-std/Test.sol";

interface IRoles {
    function execTransactionWithRole(
        address to,
        uint256 value,
        bytes calldata data,
        uint8 operation,
        bytes32 roleKey,
        bool shouldRevert
    ) external returns (bool);
}

contract BaseMorphoUSDCViaRoles is Test {
    address private constant ROLES = 0xe90af811C74E9c341F5c60DB873c5EC9DBFda425;
    address private constant FACTORY = 0x815B6A7c0b8F4D1c7cdb5031EBe802bf4f7e6d81;
    address private constant SENDER = 0x03264232431031B6484188640ECFF7BdaBDA4b8b;
    bytes32 private constant ROLE_KEY =
        0xb7f0b598bcddbe83ba50447062bac2af62f9a2f0b78dc2ca2ea758c6d18147e8;
    bytes private constant CALLDATA =
        hex"";

    function setUp() public {
        vm.createSelectFork("base", 38944012);
    }

    function test_execTransactionWithRole_revertsNotAuthorized() public {
        vm.startPrank(SENDER);
        vm.expectRevert(bytes4(0xd27b44a9)); // Roles: NotAuthorized(msg.sender)
        IRoles(ROLES).execTransactionWithRole(FACTORY, 0, CALLDATA, 0, ROLE_KEY, true);
        vm.stopPrank();
    }
}
